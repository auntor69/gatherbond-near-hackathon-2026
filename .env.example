# GatherBond Environment Configuration Template
# COPY this file to .env.local for local development. NEVER COMMIT .env or actual keys!

# NEAR Network Configuration
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEXT_PUBLIC_NEAR_NODE_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_CONTRACT_NAME=gatherbond-escrow.testnet

# Turso Database Configuration (For off-chain event metadata/indexing only)
# Server-only: never expose TURSO_AUTH_TOKEN to the browser.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Local metadata database for development/tests. When neither this nor the Turso
# variables are set, the metadata API returns 503 and escrow remains fully usable.
# METADATA_SQLITE_PATH=.data/gatherbond.sqlite

# Read-only RPC used to verify metadata hashes against get_event.
# NEAR_RPC_URL=https://rpc.testnet.near.org
# Server-side contract account (falls back to NEXT_PUBLIC_CONTRACT_NAME).
# CONTRACT_NAME=gatherbond-escrow.testnet

# NEP-413 wallet sessions (server-only). Generate a secret with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# When unset, login answers 503 and metadata writes stay 401 (fail closed).
# GATHERBOND_SESSION_SECRET=
# The recipient string wallets sign; the client and server must agree exactly.
# GATHERBOND_AUTH_RECIPIENT=gatherbond.app
# GATHERBOND_SESSION_TTL_SECONDS=7200
# Set to 1 when served over HTTPS so the session cookie gets the Secure attribute.
# GATHERBOND_SECURE_COOKIES=1

# Rate limiting (process-local fixed windows; see BUILD_LOG.md). Defaults are safe.
# GATHERBOND_LOGIN_RATE_LIMIT=10
# GATHERBOND_LOGIN_ACCOUNT_RATE_LIMIT=10
# GATHERBOND_LOGIN_RATE_WINDOW_SECONDS=60
# GATHERBOND_WRITE_RATE_LIMIT=30
# GATHERBOND_WRITE_RATE_WINDOW_SECONDS=60
# Publication POST/DELETE calls use the same per-actor write limiter; there is no bypass.
# Explicit escape hatch for local tests only; never set this in a deployed environment.
# GATHERBOND_RATE_LIMIT_DISABLED=1

# Development only: trust the x-gatherbond-actor header for metadata writes.
# Ignored unless this is exactly "1"; never set it in a deployed environment.
# GATHERBOND_ALLOW_DEV_ACTOR=1
