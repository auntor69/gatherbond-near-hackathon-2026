# GatherBond — environment template
#
# Copy the sections you need into `frontend/.env.local` for local development.
# Never commit a real `.env` / `.env.local`; both are ignored by Git.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle. Everything
# else is read only by server-side route handlers. Never move a secret into a
# NEXT_PUBLIC_ variable.

# ---------------------------------------------------------------------------
# NEAR network and contract (public)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEXT_PUBLIC_NEAR_NODE_URL=https://rpc.testnet.near.org
# Live Testnet contract holding the escrow.
NEXT_PUBLIC_CONTRACT_NAME=cynopom.testnet
# Canonical public origin used by metadata, OpenGraph URLs, robots and the sitemap.
# Use https://gatherbond.vercel.app in production; use http://localhost:3000 locally
# only when you need to inspect local canonical tags.
NEXT_PUBLIC_SITE_URL=https://gatherbond.vercel.app

# Server-side contract identity used for RPC verification and metadata binding.
# Falls back to NEXT_PUBLIC_CONTRACT_NAME when unset.
# CONTRACT_NAME=cynopom.testnet
# Read-only RPC used to check metadata hashes against get_event.
# NEAR_RPC_URL=https://rpc.testnet.near.org

# ---------------------------------------------------------------------------
# Event metadata store (server-only, optional)
# ---------------------------------------------------------------------------
# Turso/libSQL holds off-chain display metadata only. Money, reservations,
# attendance and claims are always read from the contract.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Local SQLite fallback for development and tests. When neither this nor the Turso
# pair is set, the metadata API answers 503 and escrow stays fully usable.
# METADATA_SQLITE_PATH=.data/gatherbond.sqlite

# ---------------------------------------------------------------------------
# NEP-413 wallet sessions (server-only)
# ---------------------------------------------------------------------------
# Generate a secret with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# When unset, login answers 503 and every metadata write stays 401 (fail closed).
# GATHERBOND_SESSION_SECRET=
# The recipient string wallets sign; client and server must agree exactly.
# GATHERBOND_AUTH_RECIPIENT=gatherbond.app
# GATHERBOND_SESSION_TTL_SECONDS=7200
# Set to 1 whenever the app is served over HTTPS so the cookie gains Secure.
# Required in production; leave unset only for local http:// development.
# GATHERBOND_SECURE_COOKIES=1

# ---------------------------------------------------------------------------
# Rate limiting (process-local fixed windows)
# ---------------------------------------------------------------------------
# Limits are per client and per account for login, per actor for writes.
# Over-limit requests answer 429 with Retry-After.
# GATHERBOND_LOGIN_RATE_LIMIT=10
# GATHERBOND_LOGIN_ACCOUNT_RATE_LIMIT=10
# GATHERBOND_LOGIN_RATE_WINDOW_SECONDS=60
# GATHERBOND_WRITE_RATE_LIMIT=30
# GATHERBOND_WRITE_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Development-only escape hatches — never set these in a deployment
# ---------------------------------------------------------------------------
# Trust the `x-gatherbond-actor` header for metadata writes. Ignored unless "1".
# GATHERBOND_ALLOW_DEV_ACTOR=1
# Disable the limiter entirely. Local tests only.
# GATHERBOND_RATE_LIMIT_DISABLED=1
